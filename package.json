{
  "name": "paperclip-railway-template",
  "version": "1.0.0",
  "private": true,
  "description": "Railway wrapper for Paperclip setup with bootstrap-ceo invite flow",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "typecheck": "node --check src/server.js && npm run typecheck:iac",
    "typecheck:iac": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 .railway/railway.ts",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "railway": "^3.11.0",
    "typescript": "^5.9.3"
  }
}
